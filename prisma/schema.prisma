generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Bacshop is a single merchant. Monetary values are integer IDR minor units
// (IDR has no fractional minor unit). Database checks in the initial
// migration enforce non-negative monetary and inventory quantities.

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
  PENDING_VERIFICATION
}

enum AuthIdentityType {
  PASSWORD
  OAUTH
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  CONTENT
  CUSTOMER_SUPPORT
}

enum MfaFactorType {
  TOTP
}

enum ResellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommercialContext {
  RETAIL
  RESELLER
}

enum SessionKind {
  CUSTOMER
  ADMIN
}

enum PriceKind {
  RETAIL
  RESELLER
}

enum MediaKind {
  PRODUCT_IMAGE
  PRODUCT_LOGO
  MARKETING
  CMS
  SUPPORT_ATTACHMENT
}

enum InventoryAvailability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNLIMITED
  DISCONTINUED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CheckoutStatus {
  OPEN
  PRICE_CHANGED
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  CREATED
  PROCESSING
  NEEDS_CUSTOMER_INPUT
  FULFILLED
  ISSUE
  CANCELLED
}

enum FulfillmentStatus {
  QUEUED
  PROCESSING
  NEEDS_CUSTOMER_INPUT
  FULFILLED
  ISSUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentEventType {
  CREATED
  PENDING
  SETTLEMENT
  CAPTURE
  AUTHORIZE
  DENY
  EXPIRE
  CANCEL
  REFUND
  CHARGEBACK
  FAILURE
  RECONCILIATION
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
  CANCELLED
}

enum EntitlementStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
  NOT_APPLICABLE
}

enum FulfillmentEventType {
  CREATED
  PROCESSING
  CUSTOMER_INPUT_REQUESTED
  CUSTOMER_INPUT_RECEIVED
  ACTIVATED
  FULFILLED
  FAILED
  CANCELLED
  NOTE
}

enum ResellerCustomerStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum WalletEntryType {
  TOP_UP
  PURCHASE
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
  CAMPAIGN_REWARD
  REVERSAL
}

enum WalletEntryDirection {
  CREDIT
  DEBIT
}

enum TopUpStatus {
  REQUESTED
  PENDING_RECONCILIATION
  COMPLETED
  REJECTED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUNDLE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SupportStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_OPS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_ISSUE
  PROCESSING
  ACTIVATION_READY
  CUSTOMER_INPUT_REQUIRED
  FULFILLMENT_ISSUE
  EXPIRY_REMINDER
  REFUND
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum CmsContentType {
  PAGE
  FAQ
  ANNOUNCEMENT
  SETTING
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  emailVerifiedAt DateTime?
  displayName     String?    @db.VarChar(160)
  phone           String?    @db.VarChar(32)
  status          UserStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  lastLoginAt     DateTime?  @db.Timestamptz(6)

  authIdentities          AuthIdentity[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  adminRoleAssignments    AdminRoleAssignment[]
  grantedAdminRoleAssignments AdminRoleAssignment[] @relation("AdminRoleGrantActor")
  mfaFactors              MfaFactor[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  resellerProfile         ResellerProfile?
  carts                   Cart[]
  checkouts               CheckoutSession[]
  orders                  Order[]                  @relation("CustomerOrders")
  resellerCustomer        ResellerCustomer[]       @relation("LinkedResellerCustomer")
  notifications           Notification[]
  entitlements            Entitlement[]
  promotionRedemptions    PromotionRedemption[]
  supportTickets          SupportTicket[]          @relation("CustomerSupportTickets")
  supportMessages         SupportMessage[]
  wishlists               WishlistItem[]
  recentlyViewed          RecentlyViewed[]
  recentSearches          RecentSearch[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  idempotencyKeys         IdempotencyKey[]
  outboxEvents            OutboxEvent[]            @relation("OutboxActor")

  @@index([status, createdAt])
  @@map("users")
}

model AuthIdentity {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  type              AuthIdentityType
  provider          String           @default("password") @db.VarChar(64)
  providerAccountId String?          @db.VarChar(255)
  passwordHash      String?          @db.VarChar(255)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, type])
  @@map("auth_identities")
}

model Session {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  tokenHash         String            @unique @db.VarChar(255)
  kind              SessionKind       @default(CUSTOMER)
  context           CommercialContext @default(RETAIL)
  ipAddress         String?           @db.VarChar(64)
  userAgent         String?           @db.VarChar(512)
  expiresAt         DateTime          @db.Timestamptz(6)
  revokedAt         DateTime?         @db.Timestamptz(6)
  revokedReason     String?           @db.VarChar(160)
  mfaVerifiedAt     DateTime?         @db.Timestamptz(6)
  reauthenticatedAt DateTime?         @db.Timestamptz(6)
  reauthExpiresAt   DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime          @default(now()) @db.Timestamptz(6)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([kind, revokedAt, expiresAt], map: "sessions_kind_revoked_expires_idx")
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AdminRoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  role        AdminRole
  grantedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("AdminRoleGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId, role, revokedAt])
  @@map("admin_role_assignments")
}

model MfaFactor {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  type             MfaFactorType
  secretCiphertext String            @db.Text
  label            String?           @db.VarChar(160)
  verifiedAt       DateTime?         @db.Timestamptz(6)
  lastUsedAt       DateTime?         @db.Timestamptz(6)
  lastUsedCounter  BigInt?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  disabledAt       DateTime?         @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    MfaRecoveryCode[]

  @@index([userId, type, disabledAt])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  factorId  String?    @db.Uuid
  codeHash  String     @unique @db.VarChar(255)
  usedAt    DateTime?  @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  factor    MfaFactor? @relation(fields: [factorId], references: [id], onDelete: SetNull)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(160)
  name        String    @db.VarChar(160)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  products    Product[]

  @@index([isActive, name])
  @@map("brands")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  slug        String     @unique @db.VarChar(160)
  name        String     @db.VarChar(160)
  description String?    @db.Text
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, isActive, sortOrder])
  @@map("categories")
}

model MediaAsset {
  id              String           @id @default(uuid()) @db.Uuid
  kind            MediaKind
  storageKey      String           @unique @db.VarChar(512)
  publicUrl       String?          @db.VarChar(2048)
  mimeType        String           @db.VarChar(160)
  byteSize        Int
  sha256          String?          @db.VarChar(128)
  width           Int?
  height          Int?
  altText         String?          @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  productMedia    ProductMedia[]
  marketingAssets MarketingAsset[]
  cmsContent      CmsContent[]

  @@index([kind, createdAt])
  @@map("media_assets")
}

model Product {
  id               String             @id @default(uuid()) @db.Uuid
  brandId          String?            @db.Uuid
  categoryId       String?            @db.Uuid
  slug             String             @unique @db.VarChar(200)
  name             String             @db.VarChar(255)
  shortDescription String?            @db.VarChar(500)
  description      String?            @db.Text
  termsSnapshot    Json?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  brand            Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  skus             Sku[]
  media            ProductMedia[]
  wishlistItems    WishlistItem[]
  recentlyViewed   RecentlyViewed[]
  promotions       PromotionProduct[]
  campaignProducts CampaignProduct[]

  @@index([brandId, isActive])
  @@index([categoryId, isActive])
  @@index([isActive, name])
  @@map("products")
}

model ProductMedia {
  id        String     @id @default(uuid()) @db.Uuid
  productId String     @db.Uuid
  assetId   String     @db.Uuid
  sortOrder Int        @default(0)
  isPrimary Boolean    @default(false)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([productId, assetId])
  @@index([productId, isPrimary, sortOrder])
  @@map("product_media")
}

model Sku {
  id                   String                 @id @default(uuid()) @db.Uuid
  productId            String                 @db.Uuid
  code                 String                 @unique @db.VarChar(160)
  name                 String                 @db.VarChar(255)
  variant              Json?
  fulfillmentType      String                 @db.VarChar(80)
  fulfillmentTerms     Json?
  durationDays         Int?
  durationLabel        String?                @db.VarChar(160)
  activationMethod     String?                @db.VarChar(160)
  region               String?                @db.VarChar(80)
  requirements         Json?
  accountRequirements  String?                @db.Text
  deviceRestrictions   String?                @db.Text
  warrantyTerms        String?                @db.Text
  processingSlaText    String?                @db.VarChar(255)
  supportTerms         String?                @db.Text
  processingSlaMinutes Int?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices               Price[]
  inventory            InventoryItem?
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reservations         InventoryReservation[]
  resellerCustomers    ResellerCustomer[]
  wishlistItems        WishlistItem[]
  recentlyViewed       RecentlyViewed[]
  promotionSkus        PromotionSku[]
  campaignSkus         CampaignSku[]

  @@index([productId, isActive])
  @@map("skus")
}

model Price {
  id              String        @id @default(uuid()) @db.Uuid
  skuId           String        @db.Uuid
  kind            PriceKind
  resellerTierId  String?       @db.Uuid
  amount          Int
  compareAtAmount Int?
  currency        String        @default("IDR") @db.Char(3)
  promotionId     String?       @db.Uuid
  validFrom       DateTime      @default(now()) @db.Timestamptz(6)
  validUntil      DateTime?     @db.Timestamptz(6)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  sku             Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)
  resellerTier    ResellerTier? @relation(fields: [resellerTierId], references: [id], onDelete: Restrict)
  promotion       Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([skuId, kind, validFrom, validUntil])
  @@index([resellerTierId, skuId, validFrom, validUntil])
  @@map("prices")
}

model InventoryItem {
  id           String                @id @default(uuid()) @db.Uuid
  skuId        String                @unique @db.Uuid
  onHand       Int                   @default(0)
  committed    Int                   @default(0)
  reserved     Int                   @default(0)
  availability InventoryAvailability @default(UNLIMITED)
  version      Int                   @default(0)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)
  sku          Sku                   @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([availability, updatedAt])
  @@map("inventory_items")
}

model Cart {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String?           @db.Uuid
  sessionKey String?           @unique @db.VarChar(255)
  context    CommercialContext @default(RETAIL)
  status     CartStatus        @default(ACTIVE)
  expiresAt  DateTime?         @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  checkout   CheckoutSession?

  @@index([userId, context, status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id       String   @id @default(uuid()) @db.Uuid
  cartId   String   @db.Uuid
  skuId    String   @db.Uuid
  quantity Int      @default(1)
  addedAt  DateTime @default(now()) @db.Timestamptz(6)
  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([cartId, skuId])
  @@index([skuId])
  @@map("cart_items")
}

model CheckoutSession {
  id               String            @id @default(uuid()) @db.Uuid
  cartId           String            @unique @db.Uuid
  userId           String            @db.Uuid
  context          CommercialContext
  status           CheckoutStatus    @default(OPEN)
  currency         String            @default("IDR") @db.Char(3)
  subtotalAmount   Int               @default(0)
  discountAmount   Int               @default(0)
  totalAmount      Int               @default(0)
  customerSnapshot Json?
  priceSnapshot    Json?
  expiresAt        DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  cart             Cart              @relation(fields: [cartId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order?

  @@index([userId, status, createdAt])
  @@map("checkout_sessions")
}

model Order {
  id                   String                 @id @default(uuid()) @db.Uuid
  orderNumber          String                 @unique @db.VarChar(64)
  userId               String                 @db.Uuid
  checkoutId           String?                @unique @db.Uuid
  resellerProfileId    String?                @db.Uuid
  resellerCustomerId   String?                @db.Uuid
  context              CommercialContext      @default(RETAIL)
  status               OrderStatus            @default(CREATED)
  fulfillmentStatus    FulfillmentStatus      @default(QUEUED)
  currency             String                 @default("IDR") @db.Char(3)
  subtotalAmount       Int
  discountAmount       Int                    @default(0)
  totalAmount          Int
  customerSnapshot     Json
  billingSnapshot      Json?
  termsSnapshot        Json?
  paidAt               DateTime?              @db.Timestamptz(6)
  fulfilledAt          DateTime?              @db.Timestamptz(6)
  cancelledAt          DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  user                 User                   @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  checkout             CheckoutSession?       @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  resellerProfile      ResellerProfile?       @relation(fields: [resellerProfileId], references: [id], onDelete: Restrict)
  resellerCustomer     ResellerCustomer?      @relation(fields: [resellerCustomerId, resellerProfileId], references: [id, resellerProfileId], onDelete: Restrict)
  items                OrderItem[]
  payments             Payment[]
  reservations         InventoryReservation[]
  fulfillmentEvents    FulfillmentEvent[]
  entitlements         Entitlement[]
  refunds              Refund[]
  supportTickets       SupportTicket[]
  resellerOrder        ResellerOrder?
  ledgerEntries        LedgerEntry[]
  notifications        Notification[]
  promotionRedemptions PromotionRedemption[]

  @@unique([id, resellerProfileId])
  @@index([userId, createdAt])
  @@index([status, fulfillmentStatus, createdAt])
  @@index([resellerProfileId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String            @id @default(uuid()) @db.Uuid
  orderId             String            @db.Uuid
  skuId               String            @db.Uuid
  quantity            Int
  productNameSnapshot String            @db.VarChar(255)
  skuNameSnapshot     String            @db.VarChar(255)
  skuCodeSnapshot     String            @db.VarChar(160)
  unitPrice           Int
  discountAmount      Int               @default(0)
  lineTotal           Int
  context             CommercialContext
  fulfillmentSnapshot Json
  termsSnapshot       Json?
  recipientSnapshot   Json?
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku                 Sku               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  entitlements        Entitlement[]

  @@index([orderId])
  @@index([skuId, createdAt])
  @@map("order_items")
}

model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  provider          String         @default("midtrans") @db.VarChar(64)
  providerPaymentId String?        @db.VarChar(255)
  providerOrderId   String?        @db.VarChar(255)
  idempotencyKey    String         @unique @db.VarChar(255)
  status            PaymentStatus  @default(PENDING)
  currency          String         @default("IDR") @db.Char(3)
  amount            Int
  paidAmount        Int?
  expiresAt         DateTime?      @db.Timestamptz(6)
  paidAt            DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  refunds           Refund[]

  @@unique([provider, providerPaymentId])
  @@unique([provider, providerOrderId])
  @@index([orderId, status])
  @@index([provider, status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id                String           @id @default(uuid()) @db.Uuid
  paymentId         String           @db.Uuid
  provider          String           @db.VarChar(64)
  providerEventId   String?          @db.VarChar(255)
  type              PaymentEventType
  status            String?          @db.VarChar(80)
  amount            Int?
  currency          String?          @db.Char(3)
  signatureVerified Boolean          @default(false)
  payload           Json
  receivedAt        DateTime         @default(now()) @db.Timestamptz(6)
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  paymentId        String       @db.Uuid
  idempotencyKey   String       @unique @db.VarChar(255)
  providerRefundId String?      @db.VarChar(255)
  amount           Int
  currency         String       @default("IDR") @db.Char(3)
  reason           String       @db.Text
  status           RefundStatus @default(REQUESTED)
  requestedById    String?      @db.Uuid
  requestedAt      DateTime     @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?    @db.Timestamptz(6)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([providerRefundId])
