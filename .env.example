# Runtime and public origin
NODE_ENV=development
BACSHOP_RUNTIME=development
APP_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Database (required when BACSHOP_RUNTIME=database; PostgreSQL in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# Session and admin MFA encryption (use generated random values in deployments)
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-a-random-value-at-least-32-characters
SESSION_TTL_SECONDS=2592000

# Optional transactional email
EMAIL_ENABLED=false
EMAIL_REQUIRED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Bacshop <no-reply@example.invalid>
SMTP_SECURE=false

# Midtrans Core API (set MIDTRANS_ENABLED=true when configured)
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_MERCHANT_ID=replace-with-midtrans-merchant-id
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_TIMEOUT_MS=10000

# Media storage: local for development, object for production
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.bacshop-uploads
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=https://storage.example.invalid
OBJECT_STORAGE_REGION=replace-with-region
OBJECT_STORAGE_BUCKET=replace-with-bucket
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.example.invalid
OBJECT_STORAGE_USE_IAM=false

# Logging and error reporting
LOG_LEVEL=debug
LOG_FORMAT=json
ERROR_REPORTING_DSN=https://public@example.invalid/0
ERROR_REPORTING_ENVIRONMENT=development

# Analytics is opt-in and must receive only approved event data
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
ANALYTICS_ENVIRONMENT=development
ANALYTICS_API_KEY=replace-with-analytics-key
ANALYTICS_ENDPOINT=https://analytics.example.invalid/collect

# Shared rate limiting in production
RATE_LIMIT_PROVIDER=memory
REDIS_URL=redis://:PASSWORD@HOST:6379/0

PORT=3000
