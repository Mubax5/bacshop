# Copy to deploy/production.env and set real values on the production server.
BACSHOP_DOMAIN=shop.example.com
BACSHOP_PUBLIC_ORIGIN=https://shop.example.com
BACSHOP_DOCKER_SUBNET=10.245.17.0/24
BACSHOP_CADDY_IP=10.245.17.2
BACSHOP_TRUSTED_PROXY_IPS=10.245.17.2

NODE_ENV=production
HOST=0.0.0.0
PORT=4173
BACSHOP_DATA_DIR=/var/lib/bacshop/private
BACSHOP_PRODUCTS_FILE=/var/lib/bacshop/products.json
BACSHOP_UPLOADS_DIR=/var/lib/bacshop/uploads
BACSHOP_ADMIN_SETUP_CODE=replace-with-a-unique-random-value-at-least-32-characters

MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=true
